{
  "license": "MIT OR Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@koharu/app",
    "build": "npm run build --workspace=@koharu/app",
    "start": "npm run start --workspace=@koharu/app",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace=@koharu/app",
    "format": "oxfmt packages tests package.json .oxfmtrc.json .vscode",
    "check": "oxfmt --check packages tests package.json .oxfmtrc.json .vscode"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "git-cliff": "^2.13.1",
    "kill-port": "^2.0.1",
    "oxfmt": "^0.56.0",
    "sponsorkit": "^17.1.1",
    "typescript": "^6.0.3"
  }
}
